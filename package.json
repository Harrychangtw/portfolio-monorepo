{
  "name": "portfolio-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check-links": "pnpm --filter harry-chang-portfolio check-links",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.8.2",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "next": "15.5.18",
      "postcss@<8.5.10": "8.5.14",
      "tailwindcss": "3.4.17",
      "minimatch@<3.1.3": "3.1.4",
      "minimatch@>=9 <9.0.7": "9.0.7",
      "flatted@<3.4.2": "3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2 <2.0.3": "2.0.3",
      "ajv@<6.14.0": "6.14.0",
      "yaml@<2.8.3": "2.8.3",
      "lodash@<4.18.0": "4.18.1",
      "defu@<6.1.5": "6.1.6",
      "effect@<3.20.0": "3.21.0",
      "mdast-util-to-hast@<13.2.1": "13.2.1",
      "i18next-fs-backend@<2.6.4": "2.6.4",
      "svix@<1.92.2": "1.92.2"
    }
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@vercel/analytics": "^1.6.1"
  }
}
