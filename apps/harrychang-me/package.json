{
  "name": "harry-chang-portfolio",
  "version": "2.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lab": "NEXT_PUBLIC_IS_STUDIO=true next dev -p 3001",
    "postinstall": "prisma generate",
    "prebuild": "prisma migrate deploy && node scripts/generate-sitemap.mjs && node scripts/fetch-fonts.mjs && node scripts/build-image-dims.mjs",
    "build": "next build",
    "build:ci": "node scripts/generate-sitemap.mjs && node scripts/fetch-fonts.mjs && node scripts/build-image-dims.mjs && next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "next lint",
    "optimize-images": "node scripts/optimize-images.js",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "prepare-content": "npm run optimize-images",
    "check-types": "tsc --noEmit",
    "check-links": "node scripts/check-links.mjs",
    "build:graph": "if [ -d .venv ]; then .venv/bin/python3 scripts/build_graph.py; else python3 scripts/build_graph.py; fi && npm run format:generated",
    "format:generated": "prettier --write content/generated/graph-embeddings-cache.json content/generated/graph-multimodal-cache.json content/generated/graph-descriptions-cache.json content/generated/section-summaries.json",
    "dev:graph": "NEXT_PUBLIC_IS_GRAPH=true next dev -p 3002",
    "publish-content": "node scripts/publish-content.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
    "@hookform/resolvers": "^3.10.0",
    "@portfolio/config": "workspace:*",
    "@portfolio/lib": "workspace:*",
    "@portfolio/ui": "workspace:*",
    "@tailwindcss/typography": "latest",
    "@types/d3-transition": "^3.0.9",
    "@vercel/postgres": "^0.10.0",
    "@vercel/speed-insights": "^1.3.1",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.0.4",
    "critters": "^0.0.23",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "date-fns": "4.1.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "8.5.1",
    "fast-xml-parser": "^5.8.0",
    "fs": "latest",
    "gray-matter": "latest",
    "gsap": "^3.15.0",
    "i18next": "^25.10.10",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "motion": "^12.38.0",
    "next": "15.5.21",
    "next-i18next": "^15.4.3",
    "next-themes": "^0.4.6",
    "path": "latest",
    "posthog-js": "^1.372.9",
    "react": "^19.2.5",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^15.7.4",
    "react-intersection-observer": "^9.16.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "2.15.0",
    "remark": "latest",
    "remark-html": "^16.0.1",
    "resend": "^6.11.0",
    "sonner": "^1.7.4",
    "unist-util-visit": "^5.1.0",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.0.3",
    "image-size": "^2.0.2",
    "postcss": "^8.5.14",
    "prisma": "^6.19.3",
    "sharp": "^0.35.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3"
  }
}
